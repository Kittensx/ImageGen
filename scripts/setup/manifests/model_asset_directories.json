      },
      "write_policy": "if_missing",
      "only_if_parent_empty": true,
      "content": "IMAGE_GEN VAE Models\n\nPlace supported full VAE model files in this folder.\n\nYou may also configure a different VAE location in user_config/user-config.yml."
    },
