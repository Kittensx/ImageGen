{
  "schema_version": 1,
  "name": "IMAGE_GEN default model asset directories",
  "resources": [
    {
      "kind": "directory",
      "path": {
        "config_key": "paths.models_root",
        "fallback": "models/StableDiffusion"
      }
    },
    {
      "kind": "directory",
      "path": {
        "config_key": "paths.checkpoints_dir",
        "fallback": "models/StableDiffusion/CheckPoints"
      }
    },
    {
      "kind": "text",
      "path": {
        "config_key": "paths.checkpoints_dir",
        "fallback": "models/StableDiffusion/CheckPoints",
        "append": "PLACE_ASSETS_HERE.txt"
      },
      "write_policy": "if_missing",
      "only_if_parent_empty": true,
      "content": "IMAGE_GEN Checkpoints\n\nPlace supported Stable Diffusion checkpoint model files in this folder (for example .safetensors checkpoint files).\n\nYou may also configure a different model location in user_config/user-config.yml. IMAGE_GEN should use the configured path rather than requiring assets to be copied into this default folder."
    },
    {
      "kind": "directory",
      "path": {
        "config_key": "paths.vae_dir",
        "fallback": "models/StableDiffusion/VAE"
      }
    },
