{
  "architecture": "sd1",
  "family": "stable-diffusion-1.x",
  "checkpoint_format": "a1111_monolithic",
  "prediction_type": "epsilon",
  "pipeline_class": "StableDiffusionPipeline",
  "tokenizer": {
    "type": "CLIPTokenizer",
    "model_name": "openai/clip-vit-large-patch14"
  },
  "text_encoder": {
    "type": "CLIPTextModel",
    "config_file": "text_encoder_config.json"
  },
  "unet": {
    "type": "UNet2DConditionModel",
    "config_file": "unet_config.json"
  },
  "vae": {
    "type": "AutoencoderKL",
    "config_file": "vae_config.json"
  },
  "scheduler_defaults": {
    "type": "DDIMScheduler",
    "num_train_timesteps": 1000,
    "beta_start": 0.00085,
    "beta_end": 0.012,
    "beta_schedule": "scaled_linear",
    "clip_sample": false,
    "set_alpha_to_one": false,
    "steps_offset": 1
  },
  "notes": [
    "This manifest targets SD1.x / SD1.5-style checkpoints.",
    "If component loading shows major shape mismatches, the checkpoint may actually be SD2.x."
  ]
}