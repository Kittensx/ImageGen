{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "imagegen://schemas/theme-package/1",
  "title": "IMAGE_GEN Theme Package Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "schemaVersion",
    "packageId",
    "name",
    "version",
    "type",
    "license",
    "compatibility",
    "capabilities",
    "contents"
  ],
  "anyOf": [
    {"required": ["publisher"]},
    {"required": ["author"]}
  ],
  "properties": {
    "schema": {
      "const": "imagegen.theme-package"
    },
    "schemaVersion": {
      "const": 1
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "type": {
      "enum": ["theme", "page_skin", "asset_pack", "theme_suite"]
    },
    "publisher": {},
    "author": {},
    "license": {
      "type": "string",
      "minLength": 1
    },
    "compatibility": {
      "type": "object"
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "global_tokens",
          "page_skin",
          "page_banner",
          "page_background",
          "icon_pack",
          "texture_pack",
          "component_surface_tokens",
          "scoped_component_css"
        ]
      }
    },
    "contents": {
      "oneOf": [
        {"type": "object"},
        {"type": "array"}
      ]
    }
  }
}
