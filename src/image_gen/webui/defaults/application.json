{
  "settings_defaults_version": 13,
  "restore_last_session": true,
  "ui_scale": 105,
  "density": "comfortable",
  "theme": "dark",
  "theme_palette": {
    "accent": {
      "name": "Sky Blue",
      "color": "#179ee7"
    },
    "surface": {
      "name": "Charcoal",
      "color": "#111d29"
    },
    "typography": {
      "font_family": "Inter",
      "primary_button_text": "#ffffff",
      "secondary_button_text": "#d5f1ff"
    },
    "semantic": {
      "surface_secondary": "#172431",
      "component_surface": "#111d29",
      "component_border": "#2b4358",
      "component_accent": "#179ee7",
      "text_primary": "#f4f9fd",
      "text_secondary": "#9db2c4"
    }
  },
  "theme_storage": {
