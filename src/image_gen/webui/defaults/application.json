      "right": [
        "live_preview",
        "active_prompt_assets",
        "memory_status",
        "runtime_status",
        "queue",
        "recent_runs",
        "prompt_presets",
        "model_refresh",
        "maintenance"
      ]
    },
    "collapsed_panels": []
